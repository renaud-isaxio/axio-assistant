[{"t": 0.1, "e": 0.58, "txt": "Bonjour,"}, {"t": 0.92, "e": 1.72, "txt": "moi c'est Axio."}, {"t": 2.12, "e": 3.26, "txt": "Je prépare vos devis,"}, {"t": 3.38, "e": 4.28, "txt": "je trie vos mails,"}, {"t": 4.46, "e": 6.18, "txt": "je relance vos clients et je cale"}, {"t": 6.2, "e": 6.76, "txt": "vos rendez-vous."}, {"t": 7.28, "e": 7.98, "txt": "Avec vos prix,"}, {"t": 8.14, "e": 8.74, "txt": "vos modèles,"}, {"t": 8.86, "e": 9.36, "txt": "vos outils."}, {"t": 9.78, "e": 9.88, "txt": "Vous,"}, {"t": 10.1, "e": 10.62, "txt": "vous validez."}, {"t": 11.04, "e": 12.06, "txt": "On en parle trente minutes ?"}]